modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "mesa", "pango", "cairo", "alsa-lib", "gtk3", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "libgbm", "libxkbcommon", "gtk4", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "vulkan-loader", "icu", "libwebp", "libsoup_3", "libsecret", "libmanette", "libxslt", "woff2", "libevent", "icu74", "libxml2", "sqlite", "lcms2", "libopus", "flite", "libavif", "harfbuzzFull", "libepoxy", "libjpeg", "enchant2", "hyphen", "libglvnd", "x264", "libgcc", "libjpeg8", "libGL", "gst_all_1.gst-libav"]

[userenv]

[userenv.shared]
AI_MODEL = "gpt-5.6-luna"

[objectStorage]
defaultBucketID = "replit-objstore-3f640d61-a6fc-4323-961b-c945daf356d8"
